# Скопируй на сервер: /etc/glagolitsa/production.env
# chmod 600 /etc/glagolitsa/production.env

ENV=production
GO_ENV=production
ADDR=127.0.0.1:8080

# Сгенерируй: openssl rand -hex 32
JWT_SECRET=change-me
DEVICE_CONFIRM_SECRET=change-me-too

# Пароль Postgres = POSTGRES_PASSWORD из deploy/.env
DATABASE_URL=postgres://glagolitsa:POSTGRES_PASSWORD@127.0.0.1:5432/glagolitsa?sslmode=disable

# Чаты и вложения. Для маленького VPS используем локальный диск под
# зашифрованные blobs; клиент шифрует файл до upload.
MINIO_ENABLED=false
BLOBSTORE_BACKEND=filesystem
BLOBSTORE_DIR=data/blobs
# REDIS_URL не задаём

# Публичный URL (CORS; нативное приложение Origin не шлёт)
FRONTEND_ORIGIN=https://api.glagolit.me

# Тестовые Marco/Polo — только для отладки (prod: true после reset-prod-data.sh)
SEED_DEV_USERS=false

# Passkeys / WebAuthn (I-5). RP ID must match the registrable domain of origins.
WEBAUTHN_RP_ID=glagolit.me
WEBAUTHN_RP_DISPLAY_NAME=Glagolitsa
WEBAUTHN_ORIGINS=https://glagolit.me,https://api.glagolit.me

# HTTPS: PUBLIC_DOMAIN=api.example.com PUBLIC_HOST=<public-ip> bash setup-public-domain.sh

LOG_LEVEL=info
METRICS_ENABLED=true

# --- Push (opaque wake only; no message body in FCM) ---
# Without these, Android adapter is log-only and real phones get no push.
# 1) Create Firebase project, download service account JSON
# 2) Put real androidApp/google-services.json in the mobile app (not the stub)
# 3) On VPS:
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_FILE=/etc/glagolitsa/fcm-service-account.json
# # or: FCM_CREDENTIALS_JSON={"type":"service_account",...}

# --- Calls / RTC edge (stage 0 flags; media deploy is stage 1) ---
# Logical region for metrics/routing. Not user GPS/city.
RTC_REGION_ID=primary
# LiveKit control plane. Leave keys empty to keep CALLS_RTC_AVAILABLE fail-closed.
LIVEKIT_URL=wss://rtc.example.invalid
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LIVEKIT_TOKEN_TTL_SEC=900
# TURN: prefer short-lived credentials (TURN_SHARED_SECRET) over static user/pass.
# Never commit real secrets. Generate: openssl rand -hex 32
TURN_DOMAIN=turn.example.invalid
TURN_SHARED_SECRET=
# TURN_URL is optional extra ICE URL. Prefer TURN_DOMAIN so clients get
# UDP/3478, UDP/443, TURNS/443 and TURNS/5349.
# TURN_USERNAME=
# TURN_PASSWORD=
# STUN_SERVERS=stun:stun.example.invalid:3478
# Operational kill switch (default: true only when LIVEKIT_API_KEY+SECRET set).
# CALLS_RTC_AVAILABLE=false
# Feature flags (also served to clients via /api/client/update-policy features).
# CLIENT_FEATURE_CALLS_AUDIO=true
# CLIENT_FEATURE_CALLS_VIDEO=true
# CLIENT_FEATURE_CALLS_RTC_LIVEKIT_ENABLED=true
# CLIENT_FEATURE_CALLS_AUDIO_ONLY_ENABLED=true
# CLIENT_FEATURE_CALLS_VIDEO_ADAPTIVE_ENABLED=false
# CLIENT_FEATURE_CALLS_GROUP_READY_API_ENABLED=false
# CLIENT_FEATURE_CALLS_ROUTE_HINTS_ENABLED=false
# CLIENT_FEATURE_CALLS_UNKNOWN_REQUEST_GATE_ENABLED=true
