# Local compose / ops secrets for RTC edge. Copy to .env and chmod 600.
# Never commit real values.

# Must match keys: section in livekit.yaml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-openssl-rand-hex-32

# Same secret as coturn static-auth-secret and Go API TURN_SHARED_SECRET
TURN_SHARED_SECRET=replace-with-openssl-rand-hex-32

RTC_REGION_ID=primary
LIVEKIT_URL=wss://rtc-primary.example.invalid
TURN_DOMAIN=turn-primary.example.invalid
