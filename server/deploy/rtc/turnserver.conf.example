# coturn sample for Glagolitsa (stage 1).
# Install path example: /etc/glagolitsa/turnserver.conf
# Prefer short-lived credentials (static-auth-secret) over long-lived user/pass.

listening-port=3478
# UDP 443 does not conflict with Caddy/HTTPS on TCP 443.
alt-listening-port=443
# TURNS backup port. TCP 443 is SNI-muxed (sslh) onto this listener.
tls-listening-port=5349

fingerprint
lt-cred-mech
# Shared secret for time-limited credentials (HMAC). Same value as TURN_SHARED_SECRET
# on the Go API. Generate: openssl rand -hex 32
# static-auth-secret=replace-me

# Realm / domain clients see in ICE URLs (turn-<region>.example).
realm=turn.example.invalid

# Public IP for XOR-PEER / relay candidates.
# external-ip=203.0.113.10

# UDP relay port range (open in firewall / security group).
min-port=49160
max-port=49200

# Prefer no verbose logs in production (credentials must never be logged).
verbose
# no-stdout-log
# log-file=/var/log/turnserver.log

# Do not allow open relay.
no-multicast-peers
no-cli
no-tlsv1
no-tlsv1_1

# TLS certs for TURN/TLS 443 (or 5349).
# cert=/etc/letsencrypt/live/turn.example.invalid/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.example.invalid/privkey.pem

# Deny private network peer destinations (SSRF / pivot hardening).
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=127.0.0.1-127.255.255.255
