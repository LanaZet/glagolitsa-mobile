CREATE TABLE IF NOT EXISTS local_attachments (
    cache_id TEXT NOT NULL PRIMARY KEY,
    attachment_id TEXT,
    message_id TEXT,
    chat_id TEXT NOT NULL,
    owner_account_id TEXT NOT NULL,
    direction TEXT NOT NULL,
    mime_type TEXT,
    file_name TEXT,
    encrypted_path TEXT,
    thumbnail_path TEXT,
    encrypted_size INTEGER NOT NULL DEFAULT 0,
    plaintext_size INTEGER NOT NULL DEFAULT 0,
    state TEXT NOT NULL,
    last_accessed_at TEXT,
    created_at TEXT NOT NULL,
    expires_at TEXT,
    error TEXT
);

CREATE INDEX IF NOT EXISTS local_attachments_attachment_id ON local_attachments(attachment_id);
CREATE INDEX IF NOT EXISTS local_attachments_message_id ON local_attachments(message_id);
CREATE INDEX IF NOT EXISTS local_attachments_chat_id ON local_attachments(chat_id);
CREATE INDEX IF NOT EXISTS local_attachments_state ON local_attachments(state);
CREATE INDEX IF NOT EXISTS local_attachments_trim ON local_attachments(last_accessed_at, created_at);
